<?php

namespace {{ namespace }};

use App\Http\Controllers\Controller;
{{ imports }}
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;

class {{ class }} extends Controller
{
    public function index(Request $request, {{ query_list }} $query): AnonymousResourceCollection
    {
        $filters = new {{ filters_dto }}($request->all());

        return {{ resource }}::collection($query->handle($filters));
    }

    public function store({{ store_request }} $request, {{ action_create }} $action): JsonResponse
    {
        $item = $action->handle($request->validated());

        return (new {{ resource }}($item))
            ->response()
            ->setStatusCode(201);
    }

    public function show(int $id): {{ resource }}
    {
        return new {{ resource }}({{ model }}::findOrFail($id));
    }

    public function update({{ update_request }} $request, int $id, {{ action_update }} $action): {{ resource }}
    {
        $item = {{ model }}::findOrFail($id);
        $item = $action->handle($item, $request->validated());

        return new {{ resource }}($item);
    }

    public function destroy(int $id, {{ action_delete }} $action): JsonResponse
    {
        $item = {{ model }}::findOrFail($id);
        $action->handle($item);

        return response()->json(['message' => 'Deleted successfully.']);
    }
}
