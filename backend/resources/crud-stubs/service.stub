use Illuminate\Database\Eloquent\Collection;

class {{ class }}
{
    public function __construct(
        protected AuditLogService $auditLogService
    ) {}

    public function list(array $filters = []): LengthAwarePaginator|Collection
    {
        $query = {{ model }}::query();

        if (! empty($filters['search'])) {
            $search = $filters['search'];
            $query->where(function ($q) use ($search) {
{{ search_conditions }}
            });
        }

        $query->latest();

        if (! empty($filters['per_page'])) {
            return $query->paginate((int) $filters['per_page']);
        }

        return $query->get();
    }

    public function find(int $id): {{ model }}
    {
        return {{ model }}::query()->findOrFail($id);
    }

    public function create(array $data): {{ model }}
    {
        $record = {{ model }}::query()->create($data);

        $this->auditLogService->logRecordCreatedIfEnabled($record);

        return $record;
    }

    public function update({{ model }} ${{ variable }}, array $data): {{ model }}
    {
        $oldValues = ${{ variable }}->attributesToArray();

        ${{ variable }}->update($data);

        $record = ${{ variable }}->fresh();

        $this->auditLogService->logRecordUpdatedIfEnabled(
            $record,
            $oldValues,
            $record->attributesToArray()
        );

        return $record;
    }

    public function delete({{ model }} ${{ variable }}): bool
    {
        $this->auditLogService->logRecordDeletedIfEnabled(${{ variable }});

        return (bool) ${{ variable }}->delete();
    }
}
